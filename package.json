{
  "name": "@_deep4wee/agent-lens",
  "version": "1.2.0",
  "description": "Visual self-check UI runner for AI coding agents",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./plugins/desktop-webview2": {
      "types": "./dist/plugins/desktop-webview2/index.d.ts",
      "import": "./dist/plugins/desktop-webview2/index.mjs",
      "require": "./dist/plugins/desktop-webview2/index.js"
    },
    "./plugins/mock-ipc": {
      "types": "./dist/plugins/mock-ipc/index.d.ts",
      "import": "./dist/plugins/mock-ipc/index.mjs",
      "require": "./dist/plugins/mock-ipc/index.js"
    },
    "./plugins/live-controller": {
      "types": "./dist/plugins/live-controller/index.d.ts",
      "import": "./dist/plugins/live-controller/index.mjs",
      "require": "./dist/plugins/live-controller/index.js"
    },
    "./plugins/a11y-tree": {
      "types": "./dist/plugins/a11y-tree/index.d.ts",
      "import": "./dist/plugins/a11y-tree/index.mjs",
      "require": "./dist/plugins/a11y-tree/index.js"
    },
    "./plugins/visual-diff": {
      "types": "./dist/plugins/visual-diff/index.d.ts",
      "import": "./dist/plugins/visual-diff/index.mjs",
      "require": "./dist/plugins/visual-diff/index.js"
    },
    "./plugins/video-recorder": {
      "types": "./dist/plugins/video-recorder/index.d.ts",
      "import": "./dist/plugins/video-recorder/index.mjs",
      "require": "./dist/plugins/video-recorder/index.js"
    },
    "./plugins/screen-capture": {
      "types": "./dist/plugins/screen-capture/index.d.ts",
      "import": "./dist/plugins/screen-capture/index.mjs",
      "require": "./dist/plugins/screen-capture/index.js"
    }
  },
  "bin": {
    "agent-lens": "dist/cli.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "skills",
    "scripts",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"const fs = require('fs'); ['dist', 'artifacts'].forEach(d => fs.rmSync(d, {recursive: true, force: true})); const files = fs.readdirSync('.'); files.filter(f => f.endsWith('.tgz')).forEach(f => fs.unlinkSync(f));\"",
    "build": "npm run clean && tsup",
    "build:pack": "npm run build && npm pack",
    "postinstall": "node scripts/postinstall.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "playwright": "^1.40.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "@vitest/coverage-v8": "^2.1.9",
    "playwright": "^1.63.0",
    "tsup": "^8.0.2",
    "typescript": "^5.0.0",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "jiti": "^2.7.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "tree-kill": "^1.2.2"
  },
  "author": "deep4wee",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deep4wee/agent-lens.git"
  },
  "keywords": [
    "ai",
    "agent",
    "visual",
    "testing",
    "playwright",
    "automation",
    "screenshot",
    "ui"
  ],
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/deep4wee/agent-lens/issues"
  },
  "homepage": "https://github.com/deep4wee/agent-lens#readme"
}
